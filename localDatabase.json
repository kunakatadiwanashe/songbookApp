

[
  {
    "id": "1",
    "title": "IMI MURI IZWI",
    "subtitle": "O Bright, Eternal One",
    "tune": "Quam Dialecta, 218",
    "author": "Catherine Baird (1896-1984)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Imi muri izwi",
          "Rakasika mwenje",
          "Nayo mvonga mvonga",
          "Ikave rufaro"
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Nomukutambudzwa",
          "Makamutsurudza",
          "Mwoyo yavatendi,",
          "Vakakushumirai."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Izwi rakavanda,",
          "Tokuona zvino",
          "Napatinofamba,",
          "Kristu, ari pano."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Togara maari,",
          "Iye wokudenga;",
          "Ngatimutsvagei,",
          "Dakara tamuda."
        ]
      },
      {
        "stanza": "5",
        "lines": [
          "O, Ishe, mupenyu,",
          "Mwoyo yodudzira",
          "Runako rwenyu, 'She,",
          "Nokubwinya kwenyu."
        ]
      }
    ]
  },
  {
    "id": "2",
    "title": "IMI MURI RUDEKARO",
    "subtitle": "Thou Hidden Source of Calm Repose",
    "tune": "Wells, 318",
    "author": "Charles Wesley (1707-88)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Imi muri rudekaro",
          "Rwakavanzika murudo;",
          "Chipotero kuvavengi",
          "Ndofadzwa kana muneni.",
          "Muzvitadzo, mukunyadzwa,",
          "Ndovanzwa nemi, jesu, 'She."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Zita renyu, ruponiso,",
          "Rondifadza pakudenga;",
          "Rounza simba, rugare,",
          "Norudo rusingapere;",
          "Muzita renyu ndowana",
          "Kuregererwa, noutsvene."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Jesu muri zvose zvangu",
          "Pazororo, mukurwadzawa,",
          "Murapi wemwoyo wangu;",
          "Mukurwa, ndichazorodzwa",
          "Mondifadza mberi kwemhandu,",
          "Ndowana korona yangu."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Mukushaya, mondigutsa,",
          "Muutera, mopa simba;",
          "Ndosunungurwa majoto,",
          "Mwenje, mberi kwomuvengi;",
          "Ndichadana, mogadzira",
          "Upenyu hwangu kudenga"
        ]
      }
    ]
  },
  {
    "id": "3",
    "title": "MWARI MUCHENJERI",
    "subtitle": "Immortal, Invisible",
    "tune": "St. Denio, 569",
    "author": "Walter Chalmers Smith (1824-1908)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari Muchenjeri, hamuonekwi",
          "Makavanzwa kwatiri muchiedza,",
          "Makaropafadzwa Dombo rekare,",
          "samasimba, M'kundi, tokurumbidza."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Makanyararisa kunge chiedza,",
          "Hamuperi, munotonga nesimba;",
          "Ndurano yenyu, makomo marefu,",
          "Pam'soro pamakore ane rudo."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Munopa upenyu kuna zvose;",
          "Muri mupenyu hwezvinhu zvose;",
          "Todenhera semashizha emiti;",
          "Tofa topera,asi hamusanduke."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Baba wokubwinya, muri chiedza",
          "Ngirozi dzokudza, dzovanza zviso;",
          "Tokukudzai, tiyamurei kuona",
          "Chiedza chitsvene chinokuvanzai."
        ]
      }
    ]
  },
  {
    "id": "4",
    "title": "MWARI NGAAKUDZWE",
    "subtitle": "To God Be The Glory",
    "tune": "To God be the glory, 576",
    "author": "Fanny Crosby (1820-1915)",
    "chorus": {
        "lines": [
            "Kudza; She! Kudza 'She!",
            "Nyika ngaimunzwe;",
            "Kudza; She! Kudza 'She!",
            "Vanhu ngavafare;",
            "Uyai kuna Baba nokuna Jesu,",
            "Kudzai nezvakaitirwa isu."
        ]
    },
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari ngaakudzwe nebasa rake,",
          "Norudo wakatipa mwana wake,",
          "Wakafira kudzikinura zvivi,",
          "Nokuzarura suo reupenyu."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Ruregerero rutsvene rweropa,",
          "Kumutendi chivimbiso chaMwari.",
          "Mutadzi mukuru akangotenda,",
          "Owana ruregerero rwaJesu."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Wakatidzidzisa zvinhu zvikuru",
          "Norufaro rwedu muna Jesu, 'She,",
          "Rufaro rwedu ruchave rukuru,",
          "Kana toona Jesu mumakore."
        ]
      }
    ]
  },
  {
    "id": "5",
    "title": "MWARI SAMASIMBA",
    "subtitle": "Jehovah Is Our Strength",
    "tune": "Majesty, 226; St John, 228; Millenium, 227",
    "author": "attr. Samuel Barnard",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari Samasimba,",
          "Iye rumbo rwedu;",
          "Naye tichakunda",
          "Vavengi vakuru.",
          "Satani anorwa nhando,",
          "Nokuti Mwari NdiMambo." 
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Ishe bako redu",
          "Achazongodaro;",
          "Wakamisa isu",
          "Norwake rubato.",
          "Vavengi vanorwa nhando,",
          "Nokuti Mwari ndiMambo."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Jehovah Mufudzi,",
          "Anoziva zvose;",
          "Isu tiri hwai",
          "Tichafudzwa naye.",
          "Chivi norufu inhando,",
          "Nokuti Mwari ndiMambo." 
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Mwari baba wedu,",
          "Tiri vana vake;",
          "Tichazongodaro,",
          "Haangatisiye.",
          "Masimba ose inhando,",
          "Nokuti Mwari ndiMambo." 
        ]
      }
    ]
  },
  {
    "id": "6",
    "title": "MWARI WAMARUDZI OSE",
    "subtitle": "O Thou God Of Every Nation",
    "tune": "Austria, 408; Regent Square, 423",
    "author": "William James Pearson (1832-92)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari wamarudzi ose",
          "Zvino tikomborerei;",
          "Mumwoyo tigadzirire,",
          "Uye moto wenyu;",
          "Ropafadzai Hondo yedu,",
          "Tizadzei namasimba." 
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Tizadzei noMweya M'tsvene,",
          "Mauto ashambidzwe;",
          "Nemi satani aparadzwe,",
          "Nenyika iponiswe;",
          "Ropafadzwai Hondo yedu,",
          "Titumei kwamunoda." 
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Utsvene hwenyu, tipei,",
          "Ngatizadzwe nesimba;",
          "Hondo yedu ngaitende,",
          "Nom' towo wokukunda;",
          "Ropafadzai Hondo yedu,",
          "Muve rudziviriro." 
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Ropafadzai vafundisi,",
          "Vatungamiri vose;",
          "Ropafadzaiwo vadzoki,",
          "Mauto edu ose,",
          "Ropafadzai Hondo yedu",
          "Matama tiparidze." 
        ]
      }
    ]
  },
  {
    "id": "7",
    "title": "MWARI WEDENGA NAPASI",
    "subtitle": "O Lord Of Heaven And Earth",
    "tune": "Troyte, 470; Almsgiving, 469, G",
    "author": "Christopher Wordsworth (1807-85)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari wedenga napasi,",
          "Ngakuve norurumbidzo;",
          "Toratidza rudo sei:",
          "Mupi wazvose." 
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Runyararo rwemudzimba",
          "Namakomborero ose;",
          "Tinotenda, tokurumbidzai;",
          "Mupi wazvose." 
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Makapira Mwana wenyu,",
          "Kunesu tose vepasi;",
          "Mwana wenyu mumwechete:",
          "Makapa zvose." 
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Munopa Mweya Mutsvene,",
          "Mweya worudo nesimba;",
          "Nengoni dzakawandisa,",
          "Nokwatiriwo."
        ]
      },
      {
        "stanza": "5",
        "lines": [
          "Mukununurwa muzvivi,",
          "Ndiyo nzira youdenga ;",
          "Baba varumbidzwe zvino;",
          "Mupi wazvose."
        ]
      }
    ]
  },
  {
    "id": "8",
    "title": "MWARI WEDU MUDZIVIRIRI",
    "subtitle": "A Mighty Fortress Is Our Lord",
    "tune": "Ein'Feste Burg, 640",
    "author": "Martin Luther (1483-1545), trs Frederick Henry Hedge (1805-90)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mwari wedu mudziviriri,",
          "Rusvingo rusingakundwe;",
          "Muyamuri mumirove",
          "Yedambudzo roupenyu.",
          "Sezvo mhandu yedu",
          "Satani aripo,",
          "Ane simba guru,",
          "Noruvengo rwake,",
          "Haana wezera pasi." 
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Kuvimba neredu simba",
          "Kunotiita tikundwe,",
          "Dai tisina M'ponisi",
          "Watakapiwa naMwari,",
          "Wobvunza, ndiani?",
          "Ndiye Jesu Kristu;",
          "Ishe wesabata,",
          "Asingapinduke,",
          "Achakunda mukurwa." 
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Nyangwe kune madhimoni",
          "Anoda kutinyengera;",
          "Hatitye, Mwari anoda",
          "Tikunde neidi rake.",
          "Muchinda werima",
          "Hatimudederi,",
          "Ane hasha nhando,",
          "Hona! achakundwa.",
          "Izwi duku romukunda"
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Izwi rine simba chose,",
          "Kwete, haringambomiswa.",
          "Mweya, nezvipo ndezvedu",
          "Zviri kurutivi rwedu.",
          "Upfumi nehama,",
          "Upenyu hwopera,",
          "Vangatiuraye;",
          "Chokwadi chomira,",
          "Umambo hwake narinhi."
        ]
      }
    ]
  },
  {
    "id": "9",
    "title": "MWEYA WANGU, RUMBIDZA SHE",
    "subtitle": "Praise My Soul The King of Heaven",
    "tune": "Blessed Jesus, 240; Praise My Soul The King of Heaven, 422",
    "author": "Henry Francis Lyte (1793-1857)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Mweya wangu, rumbidza 'She",
          "Pasi petsoka dzake;",
          "Wanunurwa, waponiswa,",
          "Chiimba mbiri yake;",
          "Murumbidze! Murumbidze!",
          "Kudza 'She asingafe."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Mukudze nengoni dzake",
          "Kune vari munhamo,",
          "woranga, wovaponisa,",
          "Vose vakarasika;",
          "Murumbidze! Murumbidze!",
          "Mwari anovimbika."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Sababa wotichengeta,",
          "Kana tisina simba;",
          "Wochengeta mumaoko,",
          "Torwirwa kuvavengi,",
          "Murumbidze! Murumbidze!",
          "Nengoni dzoyerera."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Ngirozi dzomurumbidza,",
          "Dzotarisana naye,",
          "Zuva, mwedzi, zvonamata",
          "Zvigereko kudenga;",
          "Murumbidze! Murumbidze!",
          "Rumbidzai Wenyasha."
        ]
      }
    ]
  },
  {
    "id": "10",
    "title": "NAMATAI MAMBO ANORUBWINYO",
    "subtitle": "O Worship The King, All Glorious",
    "tune": "Houghton, 533; Hanover, 531; Landate Dominum, 534",
    "author": "Robert Grant (1779-1839)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Namatai Mambo anorubwinyo;",
          "Imbai nesimba rudo rwakwe;",
          "Iye mudzviviriri nenhowo yedu,",
          "Agere muutsvene hune mbiri"
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Imbai zvesimba nengoni dzake,",
          "Ane nguvo, chiedza chedenga,",
          "Kutsamwa kwake, 'She, kunotinhira,",
          "Nzira yake ine rima padutu."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Nyika izere nezvishamiso,",
          "Nesimba rake, 'She, richigere,",
          "Rakadaro risingasandurwe,",
          "Zve, wakarikomberedza negungwa."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Ruchengeto rwake rwakakosha,",
          "Rwuri mumhepo, nomuchiedza;",
          "Rwobva mugomo rwopinda mubani,",
          "Rwuri m 'dova nemvura inonaya."
        ]
      },
      {
        "stanza": "5",
        "lines": [
          "Vana venyika vasina simba,",
          "Maari tinoisa ruvimbo,",
          "Tsitsi nomutsa wake hazvigume,",
          "Musiki, mudzikinuri, nehama."
        ]
      },
      {
        "stanza": "6",
        "lines": [
          "Samasimba, rudo rwakadzama,",
          "Ngirozi dzichiimba kudenga;",
          "Zvisikwa zvenyika zvisina simba,",
          "Norukudzo zvichakuimbirawo."
        ]
      }
    ]
  },
  {
    "id": "11",
    "title": "NGAARUMBIDZWE WEDENGA",
    "subtitle": "Praise To The Holiest In The Height",
    "tune": "Gerontius, 89; Richmond, 125",
    "author": "John Henry Newman (1821-77)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Ngaarumbidzwe wedenga",
          "Napasi pakudze,",
          "Namazwi ake matsvene,",
          "Nenzira dzeidi.",
          "Ungwaru hwaMwari wedu",
          "Hunokunda hwose;",
          "Kritsu wakauya kuti",
          "Azotinunura."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Adhamu wakakundika",
          "Munyama neropa,",
          "Asi rudo rwake Mwari,",
          "Rwakakunda zvose."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Ngaarumbidzwe wedenga,",
          "Napasi pakudze;",
          "Namazwi ake ma",
          "Nenzira dzeidi."
        ]
      }
    ]
  },
  {
    "id": "12",
    "title": "NGATITENDEI MWARI",
    "subtitle": "Now Thank We All Our God",
    "tune": "Now thank we all our god, 752",
    "author": "Martin Rinkart (1856-1649), trs. Catherine Winkworth (1827-78)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Ngatitendei Mwari",
          "Nemwoyo yedu yose;",
          "Anezvishamiso",
          "Zvinoifadza nyika;",
          "Kubva pauduku,",
          "Watikomborera,",
          "Nezvipo zverudo",
          "Ndezvedu narinhi."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Upfumi hwaMwari",
          "Ngahuve pedyo nesu;",
          "Mwoyo ifadziswe,",
          "Norugare kwatiri;",
          "Tigare mungoni,",
          "Dzititungamire,",
          "Dzitisunungure",
          "Pano nokudenga."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Ngaatendwe Mwari,",
          "Ngaarumbidzwe Baba,",
          "NoMwanakomana,",
          "Naye Mweya Mutsvene;",
          "Mwana mumwechete,",
          "Wepasi nedenga,",
          "Waive, achave,",
          "Nokusingapere."
        ]
      }
    ]
  },
  {
    "id": "13",
    "title": "RURIMI RWANGU, TANGISA",
    "subtitle": "Being My Tongue, Some Heavenly Theme",
    "tune": "Lydia, 110; Stracathro, 136",
    "author": "Isaac Watts (1647-1748)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Rurimi rwangu, tangisa,",
          "Mutsa izwi, imba",
          "Zviito nezita guru,",
          "ZvaShe, Samasimba."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Udza kuvimbika kwake,",
          "Nesimba panyika;",
          "Imba runako rwengoni,",
          "Dzeizwi raMwari."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Izwi rengoni nesimba",
          "Rakasika Denga;",
          "Rinotsigira nyenyedzi,",
          "Rotaura zvose."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Mwoyo wangu uchafara,",
          "Nadzo tsitsi deznyu,",
          "Nezwi iro ndinovimba",
          "Rutendo rwogutswa."
        ]
      }
    ]
  },
  {
    "id": "14",
    "title": "UMAMBO HWENYU NGAHUUYE",
    "subtitle": "Thy Kingdom Come On Bended Knee",
    "tune": null,
    "author": "F.L. Hosmer (1840-1929)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Umambo hwenyu ngahuuye!",
          "Tohunamatira;",
          "Vatendi, neshungu huru,",
          "Vanohumirira.",
          "Kunanayira kwenguva,",
          "NdokwaMwari, Baba;",
          "Nyenyedzi dzinopupura",
          "Simba nenduramo."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Zuva rinopenya kwazvo,",
          "Kunze kwotoyedza;",
          "Shongai hanzu, vatendi,",
          "Nguva yaswedera."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Zuva rinopenya kwazvo,",
          "Rodzima zvitadzo;",
          "Kururama kuchamiswa",
          "Kuporese zvose."
        ]
      },
      {
        "stanza": "4",
        "lines": [
          "Ruzivo, norunyararo,",
          "Zvichafamba kwose;",
          "Zuva rake Mwari."
        ]
      }
    ]
  },
  {
    "id": "15",
    "title": "MUNOTENDESEKA , O MWARI BABA",
    "subtitle": "Great Is Thy Faithfulness.",
    "tune": "Great is thy faithfulness, 657",
    "author": "Thomas Obediah Chisholm (1866-1960)",
    "chorus": {
      "lines": [
        "Munotendeseka!Munotendeseka!",
        "Mangwanani ndogam’chira tsitsi,",
        "Zvose zvandinoda ndopiwa nemi,",
        "Munotendeseka, ‘She, kwandiri."
      ]
    },
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Munotendeseka, O Mwari Baba,",
          "Hamuna mumvuri wesanduko,",
          "Hamungapinduke mutsitsi dzenyu,",
          "Saizvozvo, mogara narinhi."
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Zhizha, chando napo pakukohwa,",
          "Zuva, mwedzi, nyenyedzi pa’msoro,",
          "Zvinosangana zvose kupupura",
          "Kurudo rwenyu runotendeka."
        ]
      },
      {
        "stanza": "3",
        "lines": [
          "Toregererwa kwenguva yose,",
          "Kuvepo kwenyu kwotungamira;",
          "Simba ranhasi neramangwana,",
          "Makomborero angu, zvihuru."
        ]
      }
    ]
  },
  {
    "id": "16",
    "title": "VANHU VOSE VEPANYIKA",
    "subtitle": "All People That On Earth Do Dwell",
    "tune": "Old Hundredth, 38 Ab; Tallis, 41 G",
    "author": "William Kethed (1594)",
    "verses": [
      {
        "stanza": "1",
        "lines": [
          "Vanhu vose vepanyika,",
          "Imbai mose kuna ‘She;",
          "Munamatei nokutya,",
          "Farisai mberi kwake." 
        ]
      },
      {
        "stanza": "2",
        "lines": [
          "Uyu Mambo, ndiye Mwari;",
